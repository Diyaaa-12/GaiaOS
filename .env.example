# =============================================================================
# GaiaOS Local Development Environment Configuration
# =============================================================================
# Copy this file to .env in the project root for local development.
# .env is gitignored and will automatically be loaded by:
#   - FastAPI application (app.main)
#   - Alembic migration tool (alembic)
#   - Pytest suite (pytest)
#   - RQ worker and scheduler background jobs
# =============================================================================

# Active environment ("dev", "staging", "prod")
GAIAOS_ENV=dev
LOG_LEVEL=DEBUG

# Database Configuration (Docker Compose Postgres mapped to localhost:5432)
DATABASE_URL=postgresql://gaiaos:gaiaos_dev_password@localhost:5432/gaiaos

# Redis Configuration (Docker Compose Redis mapped to localhost:6379)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (Disabled by default in dev mode)
ENABLE_AUTH=false
JWT_SECRET_KEY=dev-secret-key-that-is-at-least-32-chars-long!
# Optional Static Token for Prometheus Scrapers
# PROMETHEUS_METRICS_TOKEN=<generate-32-char-random-secret-for-prometheus-scrapers>

# Optional Provider API Keys (Dev / Stubs)
# OPENAQ_API_KEY=
# FIRMS_API_KEY=
# EMBEDDING_API_KEY=
